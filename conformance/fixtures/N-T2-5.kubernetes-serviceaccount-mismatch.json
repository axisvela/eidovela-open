{
  "id": "N-T2-5",
  "description": "A Kubernetes projected token for the wrong namespace/ServiceAccount cannot enroll the Agent",
  "threat_ref": "T2",
  "expectation": "deny",
  "deny_reason": "Kubernetes ServiceAccount selector mismatch",
  "scenario": {
    "agent_class": "service",
    "binding_type": "organization_root",
    "authority_root_ref": "org:acme",
    "steps": [
      {
        "op": "register_workload",
        "workload": {
          "platform": "kubernetes",
          "selector": { "namespace": "payments", "serviceaccount": "agent", "kubernetes_issuer": "https://kubernetes.example.test" },
          "trust_domain": "example.test",
          "allowed_proof_methods": ["private_key_jwt", "k8s_projected_sa"]
        }
      },
      {
        "op": "complete_enrollment",
        "attestation": {
          "method": "k8s_projected_sa",
          "kubernetes_issuer": "https://kubernetes.example.test",
          "kubernetes_subject": "system:serviceaccount:other:agent"
        },
        "expect": "deny",
        "deny_reason": "selector"
      }
    ]
  }
}
